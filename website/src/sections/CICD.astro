---
import SectionHeader from '../components/SectionHeader.astro';

const features = [
  {
    icon: '&#x1F50D;',
    title: 'Multi-Agent Review',
    description: 'Three AI agents review your PR diff independently. Each catches different bugs, logic errors, and security issues.',
  },
  {
    icon: '&#x2696;',
    title: 'Blind Peer Review',
    description: 'Juror models rank agent reviews anonymously. No bias, no anchoring — pure signal on code quality.',
  },
  {
    icon: '&#x2705;',
    title: 'Confidence Verdict',
    description: 'A confidence score from 0-100 based on juror agreement. Pass or fail your PR check automatically.',
  },
];
---

<section class="py-24 md:py-32" id="ci-cd">
  <div class="max-w-7xl mx-auto px-6">
    <SectionHeader
      title="CI/CD Quality Gate"
      subtitle="GitHub Action"
      num="04"
    />

    <p class="text-lg text-text-secondary max-w-2xl mt-6 mb-16">
      Add multi-agent code review to every pull request. Concilium runs as a GitHub Action,
      catches bugs that single models miss, and posts a confidence-scored review
      directly on your PR.
    </p>

    <!-- Feature cards -->
    <div class="grid md:grid-cols-3 gap-6 mb-16">
      {features.map((feature) => (
        <div class="rounded-xl border border-border-primary bg-white/[0.02] p-6 hover:border-green-primary/30 transition-all duration-300 hover:scale-[1.01] backdrop-blur-sm">
          <div class="w-10 h-10 rounded-lg bg-green-primary/10 border border-green-primary/20 flex items-center justify-center text-lg mb-4">
            <span set:html={feature.icon} />
          </div>
          <h3 class="text-sm font-bold font-mono tracking-wide text-text-primary uppercase mb-2">
            {feature.title}
          </h3>
          <p class="text-sm text-text-secondary leading-relaxed font-light">
            {feature.description}
          </p>
        </div>
      ))}
    </div>

    <!-- GitHub Action YAML -->
    <div class="grid lg:grid-cols-2 gap-8">
      <!-- Left: Workflow YAML -->
      <div class="rounded-xl border border-border-primary bg-bg-page overflow-hidden shadow-2xl shadow-black/50">
        <div class="flex items-center gap-2 px-4 py-3 bg-white/[0.02] border-b border-white/5">
          <div class="flex gap-1.5">
            <div class="w-2.5 h-2.5 rounded-full bg-red-500/60"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/60"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-green-500/60"></div>
          </div>
          <span class="text-[10px] text-text-muted font-mono ml-2">.github/workflows/concilium.yml</span>
        </div>
        <div class="p-4 md:p-6 font-mono text-xs md:text-sm leading-relaxed overflow-x-auto">
          <div class="text-provider-codex/80">name: <span class="text-green-primary">Concilium Review</span></div>
          <div class="text-provider-codex/80">on:</div>
          <div class="text-text-secondary ml-2">pull_request:</div>
          <div class="text-text-secondary ml-4">types: <span class="text-text-primary">[opened, synchronize]</span></div>
          <div class="mt-3 text-provider-codex/80">jobs:</div>
          <div class="text-text-secondary ml-2">review:</div>
          <div class="text-text-secondary ml-4">runs-on: <span class="text-text-primary">ubuntu-latest</span></div>
          <div class="text-text-secondary ml-4">steps:</div>
          <div class="text-text-secondary ml-6">- uses: <span class="text-text-primary">actions/checkout@v4</span></div>
          <div class="text-text-secondary ml-6">- uses: <span class="text-green-primary">matiasdaloia/concilium-action@v1</span></div>
          <div class="text-text-secondary ml-8">with:</div>
          <div class="text-text-secondary ml-10">github-token: <span class="text-text-muted">$&#123;&#123; secrets.GITHUB_TOKEN &#125;&#125;</span></div>
          <div class="text-text-secondary ml-10">openrouter-api-key: <span class="text-text-muted">$&#123;&#123; secrets.OPENROUTER_API_KEY &#125;&#125;</span></div>
          <div class="text-text-secondary ml-10">threshold: <span class="text-green-primary">'70'</span></div>
        </div>
      </div>

      <!-- Right: Terminal output -->
      <div class="rounded-xl border border-border-primary bg-bg-page overflow-hidden shadow-2xl shadow-black/50">
        <div class="flex items-center gap-2 px-4 py-3 bg-white/[0.02] border-b border-white/5">
          <div class="flex gap-1.5">
            <div class="w-2.5 h-2.5 rounded-full bg-red-500/60"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/60"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-green-500/60"></div>
          </div>
          <span class="text-[10px] text-text-muted font-mono ml-2">PR Review Comment</span>
        </div>
        <div class="p-4 md:p-6 font-mono text-xs md:text-sm leading-relaxed overflow-x-auto">
          <div class="text-green-primary text-lg font-bold mb-3">&#x2705; PASS</div>
          <div class="text-text-secondary">
            <span class="text-text-primary font-semibold">Confidence</span>: 87% <span class="text-text-muted">(threshold: 70%)</span>
          </div>
          <div class="text-text-secondary mt-1">
            <span class="text-text-primary font-semibold">PR</span>: org/repo#42
          </div>
          <div class="text-text-secondary mt-1">
            <span class="text-text-primary font-semibold">Cost</span>: $0.0032 <span class="text-text-muted">&#183;</span> <span class="text-text-primary font-semibold">Duration</span>: 45s
          </div>

          <div class="mt-4 pt-3 border-t border-white/5">
            <div class="text-text-primary font-semibold text-xs mb-2">Consensus Ranking</div>
            <div class="space-y-1 text-xs">
              <div class="flex items-center gap-2">
                <span class="text-green-primary font-bold">1.</span>
                <span class="text-provider-opencode">opencode</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-text-muted font-bold">2.</span>
                <span class="text-provider-claude">claude</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-text-muted font-bold">3.</span>
                <span class="text-provider-codex">codex</span>
              </div>
            </div>
          </div>

          <div class="mt-4 pt-3 border-t border-white/5 text-xs text-text-muted">
            Generated by Concilium
          </div>
        </div>
      </div>
    </div>

    <!-- CLI alternative -->
    <div class="mt-12 rounded-xl border border-border-primary bg-white/[0.02] p-6 backdrop-blur-sm">
      <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-8">
        <div class="flex-1">
          <h3 class="text-sm font-bold font-mono tracking-wide text-text-primary uppercase mb-1">
            Or run from the terminal
          </h3>
          <p class="text-sm text-text-secondary">
            Same engine, same verdict. Use <code class="text-green-primary">concilium verify</code> in any CI system or locally before pushing.
          </p>
        </div>
        <div class="bg-bg-surface border border-border-secondary rounded-lg p-3 font-mono text-xs text-text-secondary shrink-0 overflow-x-auto">
          <span class="select-none text-green-primary/60 mr-2">$</span>
          <span class="text-text-primary">concilium verify --pr https://github.com/org/repo/pull/42</span>
        </div>
      </div>
    </div>

  </div>
</section>
