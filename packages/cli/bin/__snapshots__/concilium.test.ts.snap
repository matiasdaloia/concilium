// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`concilium bin (from source) > should print stable code --help output 1`] = `
"Usage: concilium code [options] [task...]

Have agent CLIs write code, one git worktree each

Arguments:
  task                   The coding task

Options:
  --agents <list>        Candidate agents, the implementer role (e.g.
                         "claude,codex" or "claude:opus,codex:gpt-5.2-codex");
                         default: the installed, signed-in agent CLIs (see
                         \`concilium doctor\`)
  --role <role=members>  Who plays a role: planner, implementer, adversary,
                         judge or integrator, as cli[:model] (e.g.
                         "judge=codex:gpt-5.2", "adversary=claude,gemini");
                         repeatable, and beats .concilium/factory.yaml and saved
                         config (see \`concilium roles\`)
  --type <type>          Task type, which picks the playbook and default rubric:
                         bugfix, feature, refactor, perf, prototype (default:
                         guessed from the task)
  --cwd <path>           Directory of the git repo to work on (default: "/")
  --include-dirty        Start from the uncommitted changes too (snapshotted to
                         a scratch ref) instead of refusing a dirty tree
  --timeout <minutes>    Wall-clock limit per candidate and per adversary in
                         minutes (default: 30)
  --no-verify            Skip the gates (.concilium/verify.yaml, or the detected
                         test, lint and typecheck commands) and the integrity
                         checks after the candidates finish; also skips the
                         adversarial tests
  --no-adversarial       Skip the adversarial round, where one agent per family
                         writes tests against the other candidates
  --no-judge             Do not ask a judge CLI (from another model family when
                         one is usable) to order candidates tied on the
                         evidence; a tie at the top goes to the smallest diff
  --no-synthesis         Do not graft ideas from the other candidates into the
                         winner on the integration branch, and write no
                         result.patch or synthesis.md; also skips the divergence
                         check that ends a run in reframe-needed (exit 2)
  --no-trail-commit      Keep the decision trail (decisions.tsv, dissent.json,
                         synthesis.md) in the run directory only, instead of
                         committing it under .concilium/runs/<run-id>/ as the
                         last commit of the integration branch
  --json                 Output the run record as JSON to stdout
  -h, --help             display help for command
"
`;

exports[`concilium bin (from source) > should print stable run --help output 1`] = `
"Usage: concilium run [options] [prompt...]

Run a deliberation pipeline

Arguments:
  prompt                 The prompt to deliberate on

Options:
  -f, --file <path>      Read prompt from file (- for stdin)
  --agents <list>        Agents to use (e.g. "claude,codex,gemini" or
                         "claude:opus,codex:gpt-5.2-codex"); default: the
                         installed, signed-in agent CLIs (see \`concilium
                         doctor\`)
  --juror-models <list>  Jurors, comma-separated: agent CLIs (e.g.
                         "claude,codex:gpt-5.2,gemini") or OpenRouter model IDs
                         (need an API key); default: the installed agent CLIs
  --chairman <model>     Chairman: an agent CLI (e.g. "gemini", "claude:opus")
                         or an OpenRouter model ID; default: an installed CLI
                         from another family than most jurors
  --cwd <path>           Project working directory (default: "/")
  --json                 Output as JSON to stdout
  --output <file>        Save synthesis to file
  --no-save              Don't persist run to history
  --verbose              Debug logging
  --quiet                Minimal output
  -h, --help             display help for command
"
`;

exports[`concilium bin (from source) > should print stable top-level --help output 1`] = `
"Usage: concilium [options] [command]

Multi-LLM deliberation platform with peer review and synthesis

Options:
  -V, --version               output the version number
  -h, --help                  display help for command

Commands:
  run [options] [prompt...]   Run a deliberation pipeline
  code [options] [task...]    Have agent CLIs write code, one git worktree each
  history [options] [run-id]  List or view past deliberation runs
  config                      Manage configuration
  models [options]            List available models
  doctor [options]            Check installed agent CLIs and how they sign in
  roles [options]             Show who plays each role and where it was set
  gc [options]                Remove worktrees and branches of finished runs
  trail                       Audit the decision trail of a code run
  gates [options]             List paused actions from each run's gates.md
  approve <gate-id>           Approve one paused action and run its command
  reject <gate-id>            Reject one paused action; its command never runs
  help [command]              display help for command
"
`;
